# ============================================
# BREVI E-Commerce Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ============================================
# Site Configuration
# ============================================
NEXT_PUBLIC_SITE_URL=https://brevibrushes.com
NEXT_PUBLIC_SITE_NAME=BREVI

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project settings
# Dashboard: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Email Configuration
# ============================================
# Configure email settings in /admin/settings/email
# These are fallback values if not configured in admin panel

# Microsoft 365 SMTP (for system emails: order confirmations, shipping, etc.)
EMAIL_SERVER_HOST=smtp.office365.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=hello@brevibrushes.com
EMAIL_SERVER_PASSWORD=your-password-or-app-specific-password
EMAIL_FROM=hello@brevibrushes.com

# SendGrid (for marketing emails: campaigns, automations, newsletters)
# Get from SendGrid Dashboard: https://app.sendgrid.com/settings/api_keys
# These are optional - you can also configure in /admin/settings/email
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
# Alternative variable name (also supported):
# EMAIL_SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# ============================================
# Payment Gateway (Stripe)
# ============================================
# Get from Stripe Dashboard: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Webhook Secrets
# Get from Stripe Dashboard > Webhooks
# Main webhook (Brevi) - handles payment, refunds, disputes, etc. (~94 events)
STRIPE_WEBHOOK_SECRET=whsec_...

# Account events webhook (exquisite-celebration-thin) - handles account events (~17 events)
STRIPE_WEBHOOK_SECRET_ACCOUNT=whsec_...

# ============================================
# AI Support (OpenAI)
# ============================================
# Used for AI chat suggestions in support system
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ============================================
# Push Notifications (Firebase Cloud Messaging)
# ============================================
# Configure in /admin/settings/push
# Get from: https://console.firebase.google.com/
# 
# Firebase Web App Config (Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=brevi-ecommerce.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=brevi-ecommerce
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=brevi-ecommerce.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
NEXT_PUBLIC_FIREBASE_VAPID_KEY=B...your-vapid-key
#
# Firebase Admin SDK (Server-side)
# Get from: Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=brevi-ecommerce
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@brevi-ecommerce.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ============================================
# Development/Testing (Optional)
# ============================================
# For local development, you may want to override the site URL
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# Notes
# ============================================
# 1. Email Configuration:
#    - For Microsoft 365, use an app-specific password for better security
#    - The "From" email should match the SMTP user email to avoid SendAsDenied errors
#    - Or grant "Send As" permission in Microsoft 365 Admin Center
#    - SendGrid API key can be set here OR in /admin/settings/email (database takes priority)
#    - SendGrid sender email must be verified in SendGrid: https://app.sendgrid.com/settings/sender_auth
#
# 2. Stripe Webhooks:
#    - Configure webhook endpoint: https://brevibrushes.com/api/webhooks/stripe
#    - Add both webhook secrets if using multiple webhook endpoints
#    - See README.md for required webhook events
#
# 3. Supabase Storage:
#    - Create buckets: cms-media, product-media, user-media
#    - Set buckets to public
#    - Configure CORS if needed
#
# 4. Security:
#    - Never commit this file or .env.local to version control
#    - Use strong, unique passwords
#    - Rotate API keys regularly
#    - Use environment-specific values for production

